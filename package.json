{
  "name": "zhixu-ai-baklib",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm-run-all --parallel build:css build:js",
    "build:css": "npx @tailwindcss/cli -i ./src/stylesheets/application.css -o ./assets/stylesheets/application.css",
    "build:js": "npx esbuild ./src/javascripts/application.js --bundle --minify --outfile=./assets/javascripts/application.js",
    "dev": "npm-run-all --parallel 'build:css --watch' 'build:js --watch'",
    "preview:build": "node scripts/build-preview.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.4",
    "daisyui": "^5.5.20",
    "esbuild": "^0.19.3",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.4"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.13.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^7.3.0",
    "@tailwindcss/typography": "^0.5.15",
    "alpinejs": "^3.13.0",
    "aos": "^3.0.0-beta.6",
    "i18next": "^23.7.11",
    "jarallax": "^2.2.1",
    "lucide": "^1.17.0",
    "stimulus-dropdown": "^2.1.0",
    "swiper": "^11.0.6",
    "typed.js": "^2.1.0",
    "viewerjs": "^1.11.7"
  }
}
