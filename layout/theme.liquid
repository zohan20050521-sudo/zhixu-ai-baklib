<!DOCTYPE html>
<html lang="{{ site.language }}">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="Baklib">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% meta_tags %}
    {% render 'theme_runtime_colors' %}
    {{ 'stylesheets/application.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'javascripts/application.js' | asset_url | script_tag: defer: true, data-turbo-track: 'reload' }}
    {%# AI Search %}
    {{ 'baklib/shared/main.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.js' | asset_url | script_tag: defer: true, data-turbo-track: 'reload' }}

    {%# TIPS：在低代码平台开发时，请打开下一行代码注释 %}
    {% if false %} {{ 'javascripts/cdn.tailwindcss.js' | asset_url | script_tag: data-turbo-track: 'reload' }} {% endif %}
    {{ site.settings.head_html }}
    
  </head>
  <body id="js-body" class="font-sans text-base font-normal text-base-content bg-base-100" data-aos-easing="ease-out-cubic" data-aos-duration="650" data-aos-delay="0">

    {% render 'header' %}
    {{ content_for_layout }}
    {% render 'footer' %}
    
    {{ 'javascripts/prism.js' | asset_url | script_tag: defer: true, data-turbo-track: 'reload' }}
  </body>
</html>
