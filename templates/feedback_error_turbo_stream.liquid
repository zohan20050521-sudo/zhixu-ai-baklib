{% layout none %}

<turbo-stream action="replace" target="js--feedback-{{ page.id }}">
  <template>
    {% render 'feedback_btn', page: page %}
  </template>
</turbo-stream>

<turbo-stream action="remove" target="js--feedback-error"></turbo-stream>
<turbo-stream action="append" target="js--feedback-modal">
  <template>
    <div class="toast toast-top toast-center z-[9999]" id="js--feedback-error" x-data x-init="setTimeout(() => { $el.remove() }, 5000)">
      <div class="alert alert-error">
        <span>{{ errors }}</span>
      </div>
    </div>
  </template>
</turbo-stream>
