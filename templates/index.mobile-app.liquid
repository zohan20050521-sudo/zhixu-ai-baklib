<main id="content" class="zx-home">
  {% render 'zhixu/hero', page: page %}
  {% render 'zhixu/proof' %}
  {% render 'zhixu/features', page: page %}
  {% render 'zhixu/workflow' %}
  {% render 'zhixu/use_cases' %}
  {% render 'zhixu/trust' %}
  {% render 'zhixu/about' %}
  {% render 'zhixu/faq_cta', page: page %}
</main>

{% schema %}
{
  "name": "知序 AI 产品首页",
  "description": "面向团队知识管理与智能问答的产品官网首页",
  "thumb_url": "images/theme/zhixu-home.png",
  "preview_image_urls": [
    "images/theme/zhixu-home.png"
  ],
  "sub_page_templates": [
    "channel"
  ],
  "settings": [
    {
      "id": "hero_eyebrow",
      "type": "text",
      "label": "首屏标签",
      "default": "团队知识助手 · 全新上线"
    },
    {
      "id": "hero_title",
      "type": "textarea",
      "label": "首屏标题",
      "default": "把散落的知识，变成随时可用的答案。"
    },
    {
      "id": "hero_description",
      "type": "textarea",
      "label": "首屏说明",
      "default": "连接团队文档、项目资料与业务系统。知序 AI 理解上下文、保留引用来源，让每个人都能快速找到可信答案。"
    },
    {
      "id": "primary_action_label",
      "type": "text",
      "label": "首要按钮文字",
      "default": "体验产品演示"
    },
    {
      "id": "secondary_action_label",
      "type": "text",
      "label": "次要按钮文字",
      "default": "了解产品能力"
    },
    {
      "id": "features_eyebrow",
      "type": "text",
      "label": "核心能力标签",
      "default": "核心能力"
    },
    {
      "id": "features_title",
      "type": "textarea",
      "label": "核心能力标题",
      "default": "不是多一个搜索框，而是多一位懂业务的同事"
    },
    {
      "id": "features_description",
      "type": "textarea",
      "label": "核心能力说明",
      "default": "从知识接入到答案生成，每一步都围绕准确、可信与可持续运营设计。"
    },
    {
      "id": "faq_question_1",
      "type": "text",
      "label": "FAQ 1 问题",
      "default": "现有文档需要重新搬进知序 AI 吗？"
    },
    {
      "id": "faq_answer_1",
      "type": "textarea",
      "label": "FAQ 1 答案",
      "default": "不需要。知序 AI 通过连接器读取并同步现有知识，原始内容仍保留在团队正在使用的平台中。"
    },
    {
      "id": "faq_question_2",
      "type": "text",
      "label": "FAQ 2 问题",
      "default": "AI 会不会看到员工无权访问的内容？"
    },
    {
      "id": "faq_answer_2",
      "type": "textarea",
      "label": "FAQ 2 答案",
      "default": "不会。检索前会校验当前用户权限，答案只使用该用户有权访问的知识，并保留访问记录。"
    },
    {
      "id": "faq_question_3",
      "type": "text",
      "label": "FAQ 3 问题",
      "default": "回答不准确时，团队可以怎样改进？"
    },
    {
      "id": "faq_answer_3",
      "type": "textarea",
      "label": "FAQ 3 答案",
      "default": "运营人员可以查看答案来源、用户反馈与无答案问题，修订原文或补充知识后，系统会自动更新索引。"
    },
    {
      "id": "faq_question_4",
      "type": "text",
      "label": "FAQ 4 问题",
      "default": "适合从哪个场景开始试用？"
    },
    {
      "id": "faq_answer_4",
      "type": "textarea",
      "label": "FAQ 4 答案",
      "default": "建议选择资料相对集中、重复咨询较多的场景，例如客服政策、员工入职或项目交付规范，更容易快速验证价值。"
    },
    {
      "id": "cta_title",
      "type": "text",
      "label": "底部行动标题",
      "default": "让团队的下一次提问，从答案开始。"
    },
    {
      "id": "cta_description",
      "type": "textarea",
      "label": "底部行动说明",
      "default": "从一个真实场景开始，体验知识被连接、理解和复用的完整过程。"
    }
  ]
}
{% endschema %}
