              <span class="counter">5,596,756</span> <span>$</span>
            </div>
            <span class="block uppercase text-primary-content">AD Spend</span>
          </div>
        </div>

        <div class="flex-shrink max-w-full px-4 w-full sm:w-1/2 lg:w-1/4">
          <div class="p-6 relative mb-6">
            <div class="text-2xl leading-normal mb-2 font-semibold text-primary-content">
              <span class="counter">456,959,000</span>
            </div>
            <span class="block uppercase text-primary-content">Impression</span>
          </div>
        </div>

        <div class="flex-shrink max-w-full px-4 w-full sm:w-1/2 lg:w-1/4">
          <div class="p-6 relative mb-6">
            <div class="text-2xl leading-normal mb-2 font-semibold text-primary-content">
              <span class="counter">3,469,000</span>
            </div>
