{% schema %}
    {
    "name": "Index.Social Media",
    "description": "Social media marketing homepage layout",
    "thumb_url": "images/theme/${lang}/index-social-media.jpg",
    "preview_image_urls": [
        "images/theme/${lang}/index-social-media.jpg"
    ],
    "sub_page_templates": [
        "channel"
    ],
    "settings": [
        {
            "id": "title",
            "type": "html",
            "rows": "10",
            "placeholder": "",
            "label": "Homepage title",
            "default": "<span class=\"text-primary\">Social Media</span> Marketing Agency",
            "to_markdown": true
        },
        {
            "id": "description",
            "type": "textarea",
            "label": "Homepage description",
            "to_markdown": true
        },
        {
            "id": "hero_image_url",
            "type": "image_picker",
            "ratio": "4:3",
            "width": 400,
            "label": "Hero cover image",
            "to_markdown": true
        },
        {
            "id": "html_content",
            "type": "html",
            "label": "HTML content",
            "to_markdown": true
        }
    ]
}
{% endschema %}
