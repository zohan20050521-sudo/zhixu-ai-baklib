        </div>

        <div class="flex-shrink max-w-full px-4 w-full sm:w-1/2 lg:w-1/4">
          <div class="p-6 relative mb-6">
            <div class="text-2xl leading-normal mb-2 font-semibold text-primary-content">
              <span class="counter">350,078</span>
            </div>
            <span class="block uppercase text-primary-content">Conversion</span>
          </div>
        </div>
      </div>
    </div>
  </div><!-- end counter -->

