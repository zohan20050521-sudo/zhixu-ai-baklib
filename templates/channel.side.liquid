
{% assign pages = page.children_in_list %}
{% assign first_child_page = pages | first %}

{% if page.path == '/about' %}
  {% render 'zhixu/about' %}
{% else %}
<!-- Start Hero -->
{% render 'hero/hero_title', item: page %}

<!--内容版块 -->
<main class="bg-base-200 py-6 md:py-12">
  <section class="container mx-auto max-w-6xl relative px-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="md:col-span-1 bg-base-100 p-4 md:sticky md:top-24 md:h-fit rounded-md shadow-sm">
              <div class="flex flex-col space-y-3">
                  {% for item in pages %}
                      <a class="{% if first_child_page.id == item.id %} bg-primary text-primary-content {% endif %} hover:bg-primary hover:text-primary-content px-4 py-3 text-lg border-b border-base-300" href="{{ item.path }}">{{ item.link_text }}</a>
                  {% endfor %}
              </div>
          </div>
          <div class="md:col-span-3 bg-base-100 p-4">
              <div class="ProseMirror max-w-full overflow-x-auto">
                {{ first_child_page.settings.content }}
              </div>
          </div>
      </div>
  </section>
</main>
{% endif %}

{% schema %}
  {
    "name": "t:settings_schema.templates_schema.channel.side.name",
    "description": "t:settings_schema.templates_schema.channel.side.description",
    "thumb_url": "images/theme/${lang}/channel-side.png",
    "preview_image_urls": [
      "images/theme/${lang}/channel-side.png"
    ],
    "sub_page_templates": ["page.side"],
    "settings": [
      {
        "id": "title",
        "type": "text",
        "label": "t:settings_schema.page.settings.title.label",
        "to_markdown": true
      },
      {
        "id": "description",
        "type": "textarea",
        "label": "t:settings_schema.page.settings.description.label",
        "to_markdown": true
      },
      {
          "id": "thumb_image_url",
          "type": "image_picker",
          "ratio": "6:2",
          "width": 400,
          "label": "t:settings_schema.page.settings.background_cover_image.label",
          "to_markdown": true
      }
    ]
  }
{% endschema%}
