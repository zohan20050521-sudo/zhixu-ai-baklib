{% assign pages = page.parent.children_in_list %}

{% render 'hero/hero_title', item: page %}

<!--内容版块 -->
<section class="bg-base-200 py-4 md:py-8">
  <div class="container mx-auto max-w-6xl relative px-4">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="md:col-span-1 bg-base-100 p-4 md:sticky md:top-24 md:h-fit rounded-md shadow-sm">
              <div class="flex flex-col space-y-">
                  {% for item in pages %}
                      <a class="{% if page.id == item.id %} bg-primary text-primary-content {% endif %} hover:bg-primary hover:text-primary-content px-4 py-3 my-2 text-lg border-b border-base-300" href="{{ item.path }}">{{ item.link_text }}</a>
                  {% endfor %}
              </div>
          </div>
          <div class="md:col-span-3 bg-base-100 p-6">
            <!-- Article content -->
            <div class="ProseMirror max-w-full overflow-x-auto">
              {{ page.settings.content }}
            </div>
            <div class="py-4 w-full max-w-full border-t border-base-300 mt-4">
              {% render 'breadcrumb', breadcrumb: page.breadcrumb, page: page %}
            </div>
          </div>
      </div>
  </div>
</section>

<!--/ article-->
{% schema %}
  {
    "name": "t:settings_schema.templates_schema.page.side.name",
    "description": "t:settings_schema.templates_schema.page.side.description",
    "thumb_url": "images/theme/${lang}/channel-side.png",
    "preview_image_urls": [
      "images/theme/${lang}/channel-side.png"
    ],
    "sub_page_templates": [],
    "settings": [
      {
        "id": "title",
        "type": "text",
        "label": "t:settings_schema.page.settings.title.label",
        "to_markdown": true
      },
      {
        "id": "description",
        "type": "textarea",
        "label": "t:settings_schema.page.settings.description.label",
        "to_markdown": true
      },
      {
        "id": "content",
        "type": "richtext",
        "label": "t:settings_schema.page.settings.content.label",
        "to_markdown": true
      },
      {
        "id": "thumb_image_url",
        "type": "image_picker",
        "ratio": "3:3",
        "width": 100,
        "label": "t:settings_schema.templates_schema.page.side.icon_label",
        "to_markdown": true
      },
      {
        "id": "tags",
        "type": "tag_picker",
        "multiple": true,
        "label": "t:settings_schema.page.settings.tags.label",
        "to_markdown": true
      }
    ]
  }
{% endschema%}
