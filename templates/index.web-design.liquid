{% assign default_hero_image = 'images/img-min/advertising.jpg' | asset_url %}
{% assign default_about_image = 'images/img-min/purple-laptop.jpg' | asset_url %}
{% assign icons = 'book.svg|chart.svg|chat.svg|folder.svg|like.svg|search.svg' | split: '|' %}
{% assign default_icon_url = "images/img-min/icons/" | append: 'book.svg' |  asset_url %}

{% assign service_page = site.pages['/services'] %}
{% assign about_page = site.pages['/about'] %}
{% assign portfolio_page = site.pages['/portfolio'] %}

{% assign newest_pages = site.pages_in_list | order_by: '-created_at' | limit: 8 %}
{% assign hot_pages = site.pages_in_list | order_by: '-visit_count' | limit: 10 %}

{% assign brand_logos = site.settings.brand_logos | newline_to_br | split: '<br />' %}
{% assign brand_logos_size = brand_logos | size %}

{% assign counter_lines = page.settings.counter_lines | newline_to_br | split: '<br />' %}
{% assign counter_lines_size = counter_lines | size %}
{% assign default_slider_one_title = 'defaults.web_design_slider_one_title' | t %}
{% assign default_slider_two_title = 'defaults.web_design_slider_two_title' | t %}


<main id="content" class="relative">
  <!-- =========={ SLIDER }==========  -->
  <div id="slider" class="relative z-0 bg-primary overflow-hidden">
    <div class="hero-slider nav-inset-button nav-light-dots" data-controller="swiper" data-swiper-options-value='{"loop":true,"autoHeight":true,"autoplay":{"delay":4000,"disableOnInteraction":false},"pagination":{"clickable":true},"navigation":true}'>
  <div class="swiper">
    <div class="swiper-wrapper">
      <div class="swiper-slide relative z-0 px-0 py-4 w-full md:py-12" style='min-height: 520px;background-image: url("{{ page.settings.slider_one_image_url | default: default_hero_image }}");background-size: cover;'>

        <!-- background overlay -->
        <div class="absolute top-0 start-0 w-full h-full opacity-80 bg-neutral" style="z-index:-1;" aria-hidden="true"></div>

        <div class="container relative z-10 px-4 mx-auto xl:max-w-6xl">
          <div class="flex flex-row flex-wrap justify-center items-center -mx-4">
            <!-- content -->
            <div class="px-4 w-full max-w-full md:w-10/12">
              <div class="py-6 mt-12 text-center lg:py-12">
                <h1 class="mb-8 text-4xl font-semibold leading-tight text-neutral-content capitalize lg:text-5xl lg:leading-snug">
                  {{ page.settings.slider_one_title | default: default_slider_one_title }} </h1>
                <a class="inline-block px-5 py-3 leading-normal text-center text-primary-content bg-transparent rounded-md border border-base-300 hover:text-base-content hover:bg-base-300 hover:ring-0 hover:border-base-300 focus:text-base-content focus:bg-base-300 focus:border-base-300 focus:outline-none focus:ring-0" href="{{ page.settings.slider_one_url  | default: '#' }}">
                    {{ 'generic.learn_more' | t }}
                  </a>
              </div>
            </div><!-- end content -->
          </div>
        </div>
      </div>

      <div class="swiper-slide relative z-0 px-0 py-4 w-full md:py-12" style='min-height: 520px;background-image: url("{{ page.settings.slider_two_image_url | default: default_hero_image }}");background-size: cover;'>
        <!-- background overlay -->
        <div class="absolute top-0 start-0 w-full h-full opacity-80 bg-neutral" style="z-index:-1;" aria-hidden="true"></div>

        <div class="container relative z-10 px-4 mx-auto xl:max-w-6xl">
          <div class="flex flex-row flex-wrap justify-center items-center -mx-4">
            <!-- content -->
            <div class="px-4 w-full max-w-full md:w-10/12">
              <div class="py-6 mt-12 text-center lg:py-12">
                <h2 class="mb-8 text-4xl font-semibold leading-tight text-neutral-content capitalize lg:text-5xl lg:leading-snug">
                  {{ page.settings.slider_two_title | default: default_slider_two_title }} </h2>
                <a class="inline-block px-5 py-3 leading-normal text-center text-primary-content bg-transparent rounded-md border border-base-300 hover:text-base-content hover:bg-base-300 hover:ring-0 hover:border-base-300 focus:text-base-content focus:bg-base-300 focus:border-base-300 focus:outline-none focus:ring-0" href="{{ page.settings.slider_two_url |  default: '#' }}">
                  {{ 'generic.learn_more' | t }}
                </a>
              </div>
            </div><!-- end content -->
          </div>
        </div>
      </div>
        </div>
    <div class="swiper-pagination"></div>
    <button type="button" class="swiper-button-prev" aria-label="Previous slide"></button>
    <button type="button" class="swiper-button-next" aria-label="Next slide"></button>
  </div>
</div>
  </div><!-- end slider-->

  <!-- =========={ COUNTERS }==========  -->
  {% if counter_lines_size > 1 %}
    <div class="relative z-10 overflow-hidden -mt-64 lg:-mt-24">
      <div class="container px-4 mx-auto xl:max-w-6xl">
        <div class="mb-4 rounded-xl shadow bg-primary">
          <div class="flex flex-row flex-wrap pt-12 -mx-4">
            {% for line in counter_lines %}
              {% assign line_arr = line | split: '|' %}
              <div class="flex-shrink px-4 w-1/2 max-w-full md:w-1/4">
                <div class="pb-12">
                  <div class="text-center">
                    <p class="mb-1 text-3xl font-semibold leading-normal text-primary-content"><span class="counter">{{ line_arr[0] }}</span></p>
                    <p class="mb-0 text-lg font-normal leading-normal text-primary-content opacity-40">{{ line_arr[1] }}</p>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div><!-- .row -->
        </div>
      </div>
    </div>
  {% endif %}
  <!-- end counters -->


  <!-- =========={ Brand }==========  -->
  {% if site.settings.brand_logos_on %}
    {% if brand_logos_size > 1 %}
      <div id="partner-brand" class="relative py-3 bg-base-100 md:py-6 dark:bg-neutral">
        <div class="container px-4 mx-auto xl:max-w-6xl">
          <div class="flex-row flex-wrap justify-center -mx-4 lex">
            <div class="px-4 w-full">
              <!-- slider brand -->
              <div class="nav-dark-button" data-controller="swiper" data-swiper-options-value='{"loop":true,"autoHeight":true,"pagination":false,"centeredSlides":true,"slidesPerView":"auto","spaceBetween":24}'>
              <div class="swiper">
                <div class="swiper-wrapper">
                            {% for url in brand_logos %}
                              <div class="swiper-slide flex-shrink px-3 w-1/2 max-w-full text-center md:w-1/3 lg:w-1/4 xl:w-1/5 lg:px-6">
                                <a href="javascript:void(0);" class="inline-block">
                                  <img class="object-contain opacity-80 hover:brands-image hover:opacity-100" src="{{ url }}" alt="{{site.name}} Brand LOGO">
                                </a>
                              </div>
                            {% endfor %}
                              </div>
              </div>
            </div><!-- end slider brand -->
            </div>
          </div>
        </div>
      </div>
    {% else %}
      {% render 'demo/brands' %}
    {% endif %}<!-- End brand-->
  {% endif %}

  <!-- =========={ ABOUT }==========  -->
  {% if about_page %}
    <div id="about" class="relative py-6 bg-base-100 md:py-10 dark:bg-neutral">
      <div class="container px-4 mx-auto xl:max-w-6xl">
        <div class="flex flex-row flex-wrap -mx-4">
          <!-- content -->
          <div class="flex-shrink self-center px-4 w-full max-w-full lg:w-1/2 lg:order-2">
            <div class="mb-12 lg:mb-0 lg:ms-12 lg:pe-6 wow fadeInRight" data-wow-duration="1s" data-wow-delay=".1s">
              <h2 class="mb-2 text-2xl font-bold leading-normal text-base-content md:text-3xl text-base-content">{{ about_page.settings.title }}</h2>
              <p class="pb-2 mx-auto mb-12 text-xl font-light leading-relaxed text-base-content/70">
                {{ about_page.settings.description | default: 'Upgency is the leading digital marketing agency in New York. We are striving to provide integrated digital marketing solutions.' }}
                </p>
              <!-- button -->
              <a href="{{ about_page.path }}" class="px-5 py-3 leading-5 text-primary-content rounded-md border -ms-1 bg-primary border-primary hover:text-primary-content hover:bg-primary hover:ring-0 hover:border-primary focus:bg-primary focus:border-primary focus:outline-none focus:ring-0 me-3">
                <!-- <i class="fas fa-paper-plane me-1"></i> -->
                <svg xmlns="http://www.w3.org/2000/svg" width="1.5rem" height="1.5rem" class="inline-block me-2" fill="currentColor" viewBox="0 0 512 512"><path d="M53.12,199.94l400-151.39a8,8,0,0,1,10.33,10.33l-151.39,400a8,8,0,0,1-15-.34L229.66,292.45a16,16,0,0,0-10.11-10.11L53.46,215A8,8,0,0,1,53.12,199.94Z" style="fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px"/><line x1="460" y1="52" x2="227" y2="285" style="fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px"/></svg>
                {{ 'generic.learn_details' | t }}
              </a>
            </div>
          </div><!-- end content -->

          <!-- play -->
          <div class="flex-shrink px-4 w-full max-w-full lg:w-1/2 lg:order-1">
            <div class="overflow-hidden relative rounded-md hover:shadow-xl">
              <img src="{{ about_page.settings.thumb_image_url |  default: default_about_image }}" class="w-full max-w-full h-auto" alt="background images">
              <div class="absolute top-1/2 transform -translate-x-1/2 -translate-y-1/2 start-1/2 lightgallery-thumbnail">

              </div>
            </div>
          </div><!-- end team -->
        </div>
      </div>
    </div>
  {% else %}
    {% render 'demo/about' %}
  {% endif %}
  <!-- end about -->

  <!-- =========={ SERVICE }==========  -->
  {% if service_page %}
    {% render 'sections/services1', page: service_page %}
  {% else %}
    {% render 'demo/services2' %}
  {% endif %}

  <!-- =========={ PORTFOLIO }==========  -->

</main>


<!-- Posts list -->
<section class="relative py-6 -mt-24 md:py-12">
    <div class="px-4 mx-auto max-w-6xl sm:px-6">
        <div class="">
            <div class="lg:flex lg:justify-between">

                <!-- Main content -->
                <div class="lg:grow">
                    <!-- Section title -->
                    <h4 class="mb-8 text-2xl font-black lg:text-3xl font-red-hat-display">{{ 'generic.latest_content' | t }}</h4>

                    <!-- Articles container -->
                    <div class="grid gap-4 items-start md:gap-12 sm:grid-cols-2 sm:gap-x-6 md:gap-y-8">
                        {% for item in newest_pages %}
                            {% if item.settings.is_top or item.settings.is_recommend %}
                                {% continue %}
                            {% endif %}
                            <!-- 1st article -->
                            <article class="flex flex-col h-full border p-2 hover:bg-primary/5 group {% if forloop.index0 < 2 %} bg-primary/5 {% endif %}">
                                <header>
                                    <a class="block" href="{{ item.path }}"></a>
                                        <figure class="relative {% if forloop.index == 3 or forloop.index == 4 or forloop.index == 9 or forloop.index == 10 %} h-64 {% else %} h-0 pb-9/16 {% endif %}">
                                            <img class="object-cover absolute inset-0 w-full h-full duration-500 transform hover:scale-90" src="{{ item.settings.thumb_image_url | default: site.settings.default_thumb_url }}" width="352" height="198" alt="{{ item.link_text }}" />
                                        </figure>
                                    </a>
                                    <a class="hover:underline" href="{{ item.path }}">
                                        <h3 class="mb-2 text-lg tracking-tight md:text-xl font-red-hat-display">
                                            {{ item.settings.title}}
                                        </h3>
                                    </a>
                                </header>
                                <div class="text-base-content/70 text-base-content grow line-clamp-2">{{ item.settings.description |  truncate: 120 }}</div>
                                <footer class="flex items-center mt-4">
                                    <a href="javascript:void(0);">
                                        <img class="mr-3 rounded-full shrink-0" src="{{ item.author.avatar_url | default: site.settings.default_avatar_url }}" width="22" height="22" alt="Author 03" />
                                    </a>
                                    <div class="text-sm text-base-content/70">
                                        · <span class="text-base-content/70">{{ item.published_at | date: '%Y-%m-%d' }}</span>
                                    </div>
                                </footer>
                            </article>
                        {% endfor %}
                    </div>
                </div>

                <!-- Sidebar -->
                <aside class="relative mt-12 lg:mt-0 lg:w-64 lg:ml-16 lg:shrink-0">

                    <!-- Popular posts -->
                    <div class="mb-8">
                        <h4 class="mb-5 text-2xl font-black tracking-tight lg:text-3xl font-red-hat-display">{{ 'generic.hot_recommendations' | t }}</h4>
                        <ul class="-my-3">
                            {% for item in hot_pages %}
                                <li class="flex py-3 border-b border-base-300 hover:bg-primary/5">
                                    <div class="mt-1 w-12 text-xl font-black tracking-tight md:text-2xl font-red-hat-display text-base-content/60 dark:text-primary-content opacity-80 shrink-0">0{{ forloop.index }}</div>
                                    <article>
                                        <a class="hover:underline" href="{{ item.path }}">
                                            <h3 class="mb-1 tracking-tight font-red-hat-display">
                                                {{ item.link_text }}
                                            </h3>
                                        </a>
                                        <div class="text-sm text-base-content/70">
                                            {{ 'generic.published_at_colon' | t }}<span class="text-base-content/70"> {{ item.published_at | date: '%Y-%m-%d' }}</span>
                                        </div>
                                    </article>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                </aside>

            </div>
        </div>
    </div>
</section>

<!-- =========={ CTA }==========  -->
{% render 'cta/cta_one' %}
<!-- End cta -->

{% schema %}
    {
        "name": "t:settings_schema.templates_schema.index.web_design.name",
        "description": "t:settings_schema.templates_schema.index.web_design.description",
        "thumb_url": "images/theme/${lang}/index-web-design.jpg",
        "preview_image_urls": [
        "images/theme/${lang}/index-web-design.jpg"
        ],
        "sub_page_templates": ["channel"],
        "settings": [

          {"id": "counter_lines", "type": "textarea", "label": "t:settings_schema.templates_schema.index.web_design.counter_lines_label","info": "t:settings_schema.templates_schema.index.web_design.counter_lines_info", "default": "9 yrs|Experienced team with rich expertise\n800+|Trusted by leading enterprises\n10.5K|Online knowledge bases and websites\n1000+K|Digitally hosted assets\n", "to_markdown": true},

          {"type": "header", "content": "t:settings_schema.templates_schema.index.web_design.slider_one_header" },
          {"type": "paragraph", "content": "t:settings_schema.templates_schema.index.web_design.slider_one_paragraph" },
          {"id": "slider_one_title","type": "html", "rows": "10", "label": "t:settings_schema.templates_schema.index.web_design.slider_title_label", "default": "Your next-generation <span class='text-warning'>Digital Content Marketing</span> services", "to_markdown": true},
          {"id": "slider_one_url","type": "text","label": "t:settings_schema.templates_schema.index.web_design.slider_url_label", "to_markdown": true},
          {"id": "slider_one_image_url","type": "image_picker","ratio": "6:2","width": 400, "label": "t:settings_schema.templates_schema.index.web_design.slider_image_label", "to_markdown": true},
          {"type": "header", "content": "t:settings_schema.templates_schema.index.web_design.slider_two_header" },
          {"type": "paragraph", "content": "t:settings_schema.templates_schema.index.web_design.slider_one_paragraph" },
          {"id": "slider_two_title","type": "html", "rows": "10", "label": "t:settings_schema.templates_schema.index.web_design.slider_title_label", "default": "<span class='text-warning'>Digital Content Marketing</span> professional service provider.", "to_markdown": true},
          {"id": "slider_two_url","type": "text","label": "t:settings_schema.templates_schema.index.web_design.slider_url_label", "to_markdown": true},
          {"id": "slider_two_image_url","type": "image_picker","ratio": "6:2","width": 400, "label": "t:settings_schema.templates_schema.index.web_design.slider_image_label", "to_markdown": true},
          {"type": "header", "content": "t:settings_schema.templates_schema.index.web_design.html_content_header" },
          {"type": "paragraph", "content": "t:settings_schema.templates_schema.index.web_design.html_content_paragraph" },
          {"id": "section_image_url","type": "image_picker","ratio": "6:2","width": 400, "label": "t:settings_schema.templates_schema.index.web_design.section_image_label", "to_markdown": true},
          {"id": "html_content","type": "html", "label": "t:settings_schema.templates_schema.index.web_design.html_content_label", "to_markdown": true}
        ]
    }
{% endschema %}


