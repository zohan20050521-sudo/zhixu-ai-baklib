{% assign pages = page.children_in_list | order_by: '-created_at' %}
{% assign channels = site.pages['/'].children_in_list %}

<main id="content" class="bg-light">
  <!-- =========={ HERO }==========  -->
  {% render 'hero/hero_title', item: page %}

  <!-- article start -->
  <div class="relative pb-16">
    <div class="container xl:max-w-6xl mx-auto px-4">
      <div class="bg-base-100 rounded-lg shadow-lg py-10 md:py-6 lg:py-12 px-12 -mt-24">
        <div class="flex flex-wrap flex-row -mx-4 md:mt-2">
          <div class="flex-shrink w-full max-w-full lg:w-8/12">
            {% paginate_tag pages, per: 12 %}
              <!-- row -->
              <div class="flex flex-wrap flex-row justify-center -mx-4">
                {% for item in pages %}
                  <div class="flex-shrink w-full max-w-full px-4 lg:px-6">
                    <!-- Card -->
                    <div class="flex flex-col md:flex-row bg-base-100 mb-12 rounded overflow-hidden">
                      <div class="relative aspect-video overflow-hidden md:flex-shrink md:w-1/3 rounded">
                        <a href="{{ item.path }}" class="block size-full group">
                          <img class="size-full object-cover" src="{{ item.settings.thumb_image_url | default: site.settings.default_thumb_url }}" alt="{{ item.link_text }}"/>
                          <div class="absolute inset-0 z-10 hover:bg-neutral opacity-0 transition duration-700 hover:opacity-20"></div>
                        </a>
                      </div>
                      <div class="pt-6 flex-1 md:flex-shrink md:w-2/3 md:ps-8 md:pt-0">
                        <div class="mb-2">
                          <h3 class="text-xl leading-normal mb-4 font-semibold text-base-content text-base-content"><a href="{{ item.path }}" class="hover:text-primary hover:text-base-content">{{ item.link_text }}</a></h3>
                          <div class="text-base-content/70">
                            <svg class="bi bi-calendar me-2 inline-block" width=".8rem" height=".8rem" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path fill-rule="evenodd" d="M14 0H2a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V2a2 2 0 00-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z" clip-rule="evenodd"></path>
                                <path fill-rule="evenodd" d="M6.5 7a1 1 0 100-2 1 1 0 000 2zm3 0a1 1 0 100-2 1 1 0 000 2zm3 0a1 1 0 100-2 1 1 0 000 2zm-9 3a1 1 0 100-2 1 1 0 000 2zm3 0a1 1 0 100-2 1 1 0 000 2zm3 0a1 1 0 100-2 1 1 0 000 2zm3 0a1 1 0 100-2 1 1 0 000 2zm-9 3a1 1 0 100-2 1 1 0 000 2zm3 0a1 1 0 100-2 1 1 0 000 2zm3 0a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
                              </svg><span>{{ item.published_at | date: "%Y-%m-%d" }}</span>
                          </div>
                        </div>
                        <p class="text-base-content/70">{{ item.settings.description | default: item.settings.content | strip_html | truncate: 100 }}</p>
                      </div>
                    </div><!-- End card -->
                  </div>
                {% endfor %}

              </div><!-- end row -->

              <div class="text-center mt-4">
                <!-- center pagination -->
                {% render 'paginate', paginate: paginate %}
              </div>
            {% endpaginate_tag %}
          </div>

          <!-- sidebar -->
          {% render 'sidebar' %}
          <!-- end sidebar -->
        </div>
      </div>
    </div>
  </div><!-- End Blog -->
</main>

{% schema %}
  {
    "name": "t:settings_schema.templates_schema.channel.list.name",
    "description": "t:settings_schema.templates_schema.channel.list.description",
    "thumb_url": "images/theme/${lang}/channel-list.png",
    "preview_image_urls": [
      "images/theme/${lang}/channel-list.png"
    ],
    "sub_page_templates": ["page"],
    "settings": [
      {
        "id": "title",
        "type": "text",
        "placeholder": "",
        "label": "t:settings_schema.page.settings.title.label",
        "info": "t:settings_schema.page.settings.title.info",
        "to_markdown": true
      },
      {
        "id": "description",
        "type": "textarea",
        "label": "t:settings_schema.page.settings.description.label",
        "to_markdown": true
      },
      {
        "id": "thumb_image_url",
        "type": "image_picker",
        "ratio": "6:2",
        "width": 240,
        "label": "t:settings_schema.page.settings.background_cover_image.label",
        "to_markdown": true
      }
    ]
  }
{% endschema %}
