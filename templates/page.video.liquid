<!-- Blog post -->
<section class="relative">
    <section class="bg-accent-100">
      <div class="container mx-auto max-w-6xl py-6 md:py-12 px-4">
        <div>
          {% # 面包屑导航 %}
          <div class="mb-4">
            {% render 'breadcrumb', breadcrumb: page.breadcrumb, page: page %}
          </div>
          <!-- Article header -->
          <header class="py-2">
              <!-- Title and excerpt -->
              <div class="">
                <h1 class="text-2xl md:text-3xl mb-4 text-base-content">
                    {{ page.settings.title }}
                </h1>
              </div>
              <!-- Article meta -->
              <div class="md:flex md:items-center md:justify-between">
                <div class="">
                    <div class="space-x-2">
                      <span class="text-base-content/70 text-base-content/70"> {{ 'generic.published_at' | t}}：{{ page.published_at | date: "%Y-%m-%d" }}</span>
                      <span class="text-base-content/70 text-base-content/70"> ·  {{ 'generic.visits' | t }}：{{ page.visits_count  }}</span>
                    </div>
                </div>
            </div>
          </header>
        </div>
      </div>
    </section>

    <div class="container mx-auto max-w-6xl px-4 mt-4">
        <div class="flex items-center justify-center">
          {% if page.settings.youtube_id %}
              {% render 'play_youtube_video', item: page %}
          {% else %}
              <video class="w-full h-auto max-w-full"  controls>
                <source src="{{ page.settings.video_url }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
          {% endif %}
        </div>

        <article class="p-4 md:py-8 ProseMirror max-w-full overflow-x-auto">
          {{ page.settings.content }}
        </article>

        <div class="flex justify-between">
          <!--Tags-->
          {% assign tags_count = page.settings.tags | size %}
          {% if tags_count > 0 %}
            <div class="flex items-center py-4 mt-4 space-x-2 text-xs font-light md:mt-8 shrink-0">
                <p>{{ 'generic.tags' | t }}： </p>
                {% for tag in page.settings.tags %}
                    <a href="{{ tag.path }}" style="background-color: {{ tag.color }}" class="px-2 py-1 text-neutral-content rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2">
                    {{ tag.name }}
                    </a>
                {% endfor %}
            </div>
          {% endif %}

          <!-- Feedback -->
          <div class="max-w-2xl mx-auto mt-8">
            {%# render "feedback_form", page: page %}
            {%# render "feedback_btn", page: page %}
          </div>
        </div>

        <!-- Sub Post Section -->
        {%# render 'sub_page_list', page: page, show_header: false %}

    </div>
</section>


<!--/ article-->
{% schema %}
  {
    "name": "t:settings_schema.templates_schema.page.video.name",
    "description": "t:settings_schema.templates_schema.page.video.description",
    "thumb_url": "images/theme/${lang}/page.png",
    "preview_image_urls": [
      "images/theme/${lang}/page.png"
    ],
    "sub_page_templates": [],
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.templates_schema.page.video.youtube_header"
      },
      {
        "type": "paragraph",
        "content": "t:settings_schema.templates_schema.page.video.youtube_paragraph"
      },
      {
        "id": "youtube_id",
        "type": "text",
        "placeholder": "6c3RXM7lK20",
        "label": "t:settings_schema.templates_schema.page.video.youtube_id_label",
        "info": "t:settings_schema.templates_schema.page.video.youtube_id_info"
      },
      {
        "type": "header",
        "content": "t:settings_schema.templates_schema.page.video.local_video_header"
      },
      {
        "id": "thumb_image_url",
        "type": "image_picker",
        "ratio": "16:9",
        "width": 200,
        "label": "t:settings_schema.page.settings.thumb_image_url.label",
        "to_markdown": true
      },
      {
        "id": "video_url",
        "type": "video_picker",
        "ratio": "16:9",
        "width": 200,
        "label": "t:settings_schema.templates_schema.page.video.video_url_label",
        "info": "t:settings_schema.templates_schema.page.video.video_url_info"
      },
      {
        "type": "header",
        "content": "t:settings_schema.templates_schema.page.video.basic_info_header"
      },
      {
        "id": "title",
        "type": "text",
        "label": "t:settings_schema.page.settings.title.label",
        "to_markdown": true
      },
      {
        "id": "description",
        "type": "textarea",
        "label": "t:settings_schema.page.settings.description.label",
        "to_markdown": true
      },
      {
        "id": "content",
        "type": "richtext",
        "label": "t:settings_schema.page.settings.content.label",
        "to_markdown": true
      },
      {
        "id": "tags",
        "type": "tag_picker",
        "multiple": true,
        "label": "t:settings_schema.page.settings.tags.label",
        "to_markdown": true
      }
    ]
  }
{% endschema%}
