{% assign brand_name = site.settings.brand_name | default: '知序 AI' %}
{% capture default_footer_menu %}
产品[/#features{核心能力[/#features|工作方式[/#workflow|安全可信[/#trust
场景[/#use-cases{客户支持[/#use-cases|员工入职[/#use-cases|项目协作[/#use-cases
资源[/#faq{常见问题[/#faq|产品动态[/updates|关于知序[/#about
{% endcapture %}
{% assign footer_menu_text = site.settings.footer_menu | default: default_footer_menu %}
{% assign footer_menus = footer_menu_text | newline_to_br | split: '<br />' %}

<footer class="zx-footer">
  <div class="zx-shell">
    <div class="zx-footer__main">
      <div class="zx-footer__brand">
        <a class="zx-brand zx-brand--footer" href="/" aria-label="{{ brand_name | escape }} 首页">
          <span class="zx-brand__mark" aria-hidden="true"><i></i><i></i><b></b></span>
          <span class="zx-brand__name">{{ brand_name | escape }}</span>
        </a>
        <p>{{ site.settings.company_info | default: '把散落的知识，变成随时可用的答案。为团队提供可信、可追溯的 AI 知识助手。' }}</p>
        <span class="zx-footer__status"><i></i> 服务状态正常</span>
      </div>

      <nav class="zx-footer__nav" aria-label="页脚导航">
        {% for menu_line in footer_menus %}
          {% assign menu_content = menu_line | strip %}
          {% if menu_content != blank %}
            {% assign parent_and_children = menu_content | split: '{' %}
            {% assign parent_menu = parent_and_children[0] | split: '[' %}
            {% assign child_menus = parent_and_children[1] | split: '|' %}
            <div class="zx-footer__column">
              <a class="zx-footer__column-title" href="{{ parent_menu[1] | default: '/' }}">{{ parent_menu[0] | strip }}</a>
              {% for child_menu in child_menus %}
                {% assign child_menu_content = child_menu | strip %}
                {% if child_menu_content != blank %}
                  {% assign child = child_menu_content | split: '[' %}
                  <a href="{{ child[1] | default: '#' }}">{{ child[0] | strip }}</a>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      </nav>
    </div>

    <div class="zx-footer__bottom">
      <p>{{ site.settings.copyright_info | default: '© 2026 知序 AI · 保留所有权利' }}</p>
      <div class="zx-footer__legal"><a href="#trust">隐私与安全</a><a href="#faq">使用帮助</a></div>
    </div>
  </div>

  <button class="zx-back-top" type="button" data-zhixu-back-top aria-label="返回页面顶部" title="返回顶部">
    {% render 'icon', name: 'arrow-right', class: 'zx-back-top__icon' %}
  </button>
</footer>
