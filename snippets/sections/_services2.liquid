{%# 大图标 style 1: https://demo-www.uibak.com/s/snippets/services %}

<!-- start services -->
<div id="service" class="relative py-6 md:py-10 bg-base-100">
  <div class="container xl:max-w-6xl mx-auto px-4">
    <!-- section header -->
    <header class="text-center mx-auto mb-12 lg:px-20">
      <h2 class="text-2xl md:text-3xl leading-normal mb-2 font-bold text-base-content text-base-content">{{ page.link_text }}</h2>
      <hr class="block w-12 h-0.5 mx-auto my-5 bg-primary border-primary">
      <p class="text-base-content/70 leading-relaxed font-light text-xl mx-auto pb-2">
        {{ page.settings.description }} </p>
    </header><!-- end section header -->

    <!-- row -->
    <div class="flex flex-wrap flex-row text-center">
      {% for item in page.children_in_nav_menu %}
        {% assign mod = forloop.index | modulo: 2 %}
        <div class="flex-shrink max-w-full w-full md:w-1/2 lg:w-1/3">
          <!-- service block -->
          <div class="{% if mod > 0 %} bg-base-100 {% else %} bg-base-200 {% endif %} p-6 md:p-10">
            <div class="inline-block text-primary mb-2">
              {% render 'page_icon', item: item, class: 'h-16 w-16 max-w-32', fallback_name: 'layers' %}
            </div>
            <a href="{{ item.path }}" class="text-lg leading-normal mb-2 font-semibold text-base-content hover:text-primary hover:underline">{{ item.link_text }}</a>
            <p class="line-clamp-3">{{ item.settings.description }}</p>
          </div><!-- end service block -->
        </div>
      {% endfor %}
    </div><!-- end row -->
  </div>
</div><!-- End Service -->