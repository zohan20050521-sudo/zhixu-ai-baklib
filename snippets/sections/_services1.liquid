{%# 小图标 style 1: https://demo-www.uibak.com/s/snippets/services %}

{% assign default_services_title = 'defaults.services_title' | t %}
{% assign default_services_description = 'defaults.services_description' | t %}
<!-- start services -->
  <div id="service" class="relative pt-20 pb-8 md:pt-24 md:pb-12 bg-base-200">
    <div class="container xl:max-w-6xl mx-auto px-4">
      <!-- section header -->
      <header class="text-center mx-auto mb-12">
        <h2 class="text-2xl md:text-3xl leading-normal mb-2 font-bold text-base-content text-base-content">{{ page.settings.title |  default: default_services_title }}</h2>
        <hr class="block w-12 h-0.5 mx-auto my-5 bg-primary border-primary">
        <p class="text-base-content/70 leading-relaxed font-light text-xl mx-auto pb-2">{{ page.settings.description |  default: default_services_description }}</p>
      </header><!-- end section header -->

      <!-- row -->
      <div class="flex flex-wrap flex-row -mx-4 text-center">
        {% for item in page.children_in_nav_menu %}
        <div class="flex-shrink px-4 max-w-full w-1/2 md:w-1/4 lg:px-6 wow fadeInUp" data-wow-duration="1s">
          <!-- service block -->
          <a href="{{ item.path }}" class="p-2 md:p-6 mb-6 block shadow rounded bg-base-100 transform transition duration-300 ease-in-out hover:-translate-y-2 hover:shadow-xl">
            <div class="inline-block text-primary mb-4">
              {% render 'page_icon', item: item, class: 'h-12 w-12 max-w-24', fallback_name: 'briefcase' %}
            </div>
            <h3 class="text-lg leading-normal mb-2 font-semibold text-base-content text-base-content">{{ item.link_text }}</h3>
            <div class="text-base-content/70 line-clamp-3 hidden sm:flex">{{ item.settings.description | truncate: 120 }}</div>
          </a> <!-- end service block -->
        </div>
        {% endfor %}
      </div><!-- end row -->
    </div>
  </div><!-- End Service -->