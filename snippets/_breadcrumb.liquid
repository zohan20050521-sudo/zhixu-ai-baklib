{%- comment -%}
  @params breadcrumb
    array of objects with keys: link_text, path
  @params page (optional)
    current page — shows page tools on the right when present
{%- endcomment -%}

{% assign crumbs_size = breadcrumb | size %}
{% if crumbs_size > 0 or page %}
  <div class="flex flex-wrap items-center justify-between gap-3 print:hidden">
    {% if crumbs_size > 0 %}
      <ul class="list-none text-base-content/60 text-sm hidden sm:flex items-center space-x-1 min-w-0 flex-1" aria-label="{{ 'generic.breadcrumb_nav' | t: 'Breadcrumb' }}">
        {% for crumb in breadcrumb %}
          <li>
            <div class="flex items-center">
              {% if forloop.index0 > 0 %}
                {% render 'icon', name: 'chevron-right', class: 'h-5 w-5 flex-shrink-0' %}
              {% endif %}
              <a href="{{ crumb.path }}" data-turbo-frame="_top">{{ crumb.link_text }}</a>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="min-w-0 flex-1" aria-hidden="true"></div>
    {% endif %}
    {% if page %}
      <div class="shrink-0">
        {% render 'page_tools_dropdown', page: page %}
      </div>
    {% endif %}
  </div>
{% endif %}
