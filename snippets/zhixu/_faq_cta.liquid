{% assign cta_title = page.settings.cta_title | default: '让团队的下一次提问，从答案开始。' %}
{% assign cta_description = page.settings.cta_description | default: '从一个真实场景开始，体验知识被连接、理解和复用的完整过程。' %}

<section id="contact" class="zx-cta" aria-labelledby="zx-cta-title">
  <div class="zx-shell zx-cta__inner" data-aos="fade-up">
    <div>
      <span class="zx-cta__eyebrow">从一个真实问题开始</span>
      <h2 id="zx-cta-title">{{ cta_title | escape }}</h2>
      <p>{{ cta_description | escape }}</p>
    </div>
    <div class="zx-cta__actions">
      <a class="zx-button zx-button--light" href="#workspace">体验产品演示 {% render 'icon', name: 'arrow-right', class: 'zx-button__icon' %}</a>
      <a class="zx-button zx-button--ghost" href="#use-cases">查看使用场景</a>
    </div>
  </div>
</section>
