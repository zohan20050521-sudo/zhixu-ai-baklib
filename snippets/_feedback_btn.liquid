<div id="js--feedback-{{ page.id }}" class="flex flex-col items-center">
  {% if page.visitor_posted_feedback %}
    <a  data-turbo-stream="true"
        href="{{ page.feedback_path }}" class="items-center space-x-1 rounded-full p-4 border border-base-300 !bg-secondary text-secondary-content hover:bg-primary/30 hover:text-primary-content">
            {% render 'icon', name: 'message-square-dot', class: 'size-12 w-10 h-10 bg-primary' %}
    </a>
    <div>{{ 'generic.feedbacked' | t }}</div>
  {% else %}
    <a  data-turbo-stream="true"
        href="{{ page.feedback_path }}" class="items-center space-x-1 rounded-full p-4 border border-base-300 text-base-content hover:bg-primary/30 hover:text-primary-content">
            {% render 'icon', name: 'message-square-share', class: 'size-12 w-10 h-10 text-primary' %}
    </a>
    <div>{{ 'generic.feedback' | t }}</div>
  {% endif %}
  
  {% if site.settings.request_form_url %}
    <p class="mt-2 text-primary-content opacity-80 text-sm text-center">
      {{ 'snippets.feedback_btn.more_questions' | t }}
      <a href="{{ site.settings.request_form_url | default: '#' }}" target="_blank" rel="noopener noreferrer" class="text-info underline">{{ 'snippets.feedback_btn.submit_request' | t }}</a>
    </p>
  {% endif %}
</div>