{% assign brand_name = site.settings.brand_name | default: '知序 AI' %}
{% assign learn_more_title = site.settings.learn_more_title | default: '了解更多' %}
{% assign learn_more_url = site.settings.learn_more_url | default: '/#about' %}
{% assign request_title = site.settings.request_title | default: '体验产品' %}
{% assign request_url = site.settings.request_url | default: '#workspace' %}
{% capture default_header_menu %}
产品能力[/#features
工作方式[/#workflow
使用场景[/#use-cases
安全可信[/#trust
常见问题[/#faq
{% endcapture %}
{% assign header_menu_text = site.settings.header_menu | default: default_header_menu %}
{% assign header_menus = header_menu_text | newline_to_br | split: '<br />' %}

<header class="zx-header" data-zhixu-header x-data="{ open: false }" @keydown.escape.window="open = false">
  <div class="zx-shell zx-header__inner">
    <a class="zx-brand" href="/" aria-label="{{ brand_name | escape }} 首页">
      <span class="zx-brand__mark" aria-hidden="true"><i></i><i></i><b></b></span>
      <span class="zx-brand__name">{{ brand_name | escape }}</span>
    </a>

    <nav class="zx-header__nav" aria-label="主导航">
      {% for menu_line in header_menus %}
        {% assign menu_content = menu_line | strip %}
        {% if menu_content != blank %}
          {% assign parent_and_children = menu_content | split: '{' %}
          {% assign parent_menu = parent_and_children[0] | split: '[' %}
          <a href="{{ parent_menu[1] | default: '/' }}">{{ parent_menu[0] | strip }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="zx-header__actions">
      <a class="zx-header__login" href="{{ learn_more_url }}"{% if learn_more_url contains 'http' %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ learn_more_title | escape }}</a>
      <a class="zx-button zx-button--header" href="{{ request_url }}"{% if request_url contains 'http' %} target="_blank" rel="noopener noreferrer"{% endif %}>
        {{ request_title | escape }}
        {% render 'icon', name: 'arrow-right', class: 'zx-button__icon' %}
      </a>
    </div>

    <button class="zx-header__toggle" type="button" aria-controls="zx-mobile-menu" :aria-expanded="open.toString()" @click="open = !open" title="打开导航">
      <span class="sr-only">打开或关闭导航</span>
      <span x-show="!open">{% render 'icon', name: 'menu', class: 'zx-header__toggle-icon' %}</span>
      <span x-show="open" x-cloak>{% render 'icon', name: 'x', class: 'zx-header__toggle-icon' %}</span>
    </button>
  </div>

  <div id="zx-mobile-menu" class="zx-mobile-menu" x-show="open" x-cloak x-transition.opacity>
    <button class="zx-mobile-menu__backdrop" type="button" aria-label="关闭导航" @click="open = false"></button>
    <nav class="zx-mobile-menu__panel" aria-label="移动端导航" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
      {% for menu_line in header_menus %}
        {% assign menu_content = menu_line | strip %}
        {% if menu_content != blank %}
          {% assign parent_and_children = menu_content | split: '{' %}
          {% assign parent_menu = parent_and_children[0] | split: '[' %}
          <a href="{{ parent_menu[1] | default: '/' }}" @click="open = false">
            <span>{{ parent_menu[0] | strip }}</span>
            {% render 'icon', name: 'chevron-right', class: 'zx-mobile-menu__icon' %}
          </a>
        {% endif %}
      {% endfor %}
      <a href="{{ learn_more_url }}" @click="open = false"{% if learn_more_url contains 'http' %} target="_blank" rel="noopener noreferrer"{% endif %}>
        <span>{{ learn_more_title | escape }}</span>
        {% render 'icon', name: 'chevron-right', class: 'zx-mobile-menu__icon' %}
      </a>
      <a class="zx-mobile-menu__cta" href="{{ request_url }}" @click="open = false"{% if request_url contains 'http' %} target="_blank" rel="noopener noreferrer"{% endif %}>
        {{ request_title | escape }}
        {% render 'icon', name: 'arrow-right', class: 'zx-button__icon' %}
      </a>
    </nav>
  </div>
</header>
