  {
    "name": "t:settings_schema.generic.name",
    "settings": [
      {
        "id": "logo_url",
        "type": "image_picker",
        "ratio": "6:2",
        "width": 150,
        "label": "网站 LOGO",
        "info": "展示在页头导航栏"
      },
      {
        "id": "footer_logo_url",
        "type": "image_picker",
        "ratio": "8:2",
        "width": 150,
        "label": "页脚 LOGO",
        "info": "展示在页脚导航栏"
      },
      {
        "id": "slogan",
        "type": "text",
        "label": "公司一句话口号",
        "default": "我们是一家创意公司，服务于各行各业的本地和国际企业，从小型到大型企业。"
      },
      {
        "id": "request_title",
        "type": "text",
        "label": "导航按钮文字",
        "default": "联系我们"
      },
      {
        "id": "request_url",
        "type": "text",
        "label": "导航按钮链接",
        "default": "https://help.baklib.cn/themes/www",
        "info": "请填写https://开头的 URL 地址；设置以后会在文章页底部显示'Submit a request'链接"
      },
      {
        "id": "is_show_author",
        "type": "checkbox",
        "label": "文章是否显示文章作者信息",
        "info": "包括作者头像、昵称，发布日期，浏览量",
        "default": true
      },
      {
        "id": "default_avatar_url",
        "type": "image_picker",
        "ratio": "1:1",
        "width": 150,
        "label": "默认作者头像",
        "info": "展示在文章作者信息处，建议尺寸150x150px"
      },
      {
        "id": "default_thumb_url",
        "type": "image_picker",
        "ratio": "4:3",
        "width": 250,
        "label": "默认文章方面图",
        "info": "展示在文章列表封面图，建议尺寸400x300px"
      },
      {
        "id": "lucide_icons",
        "type": "textarea",
        "label": "t:settings_schema.generic.settings.lucide_icons.label",
        "info": "t:settings_schema.generic.settings.lucide_icons.info",
        "rows": 12,
        "default": "shopping-cart\nshopping-bag\nstore\ncredit-card\nwallet\nbanknote\nreceipt\ntag\ntags\npercent\ngift\npackage\npackage-check\npackage-open\ntruck\nplane\nship\ncar\nbike\nmap-pin\nmap\nnavigation\nroute\nwarehouse\ncontainer\nclock\ntimer\ncalendar\ncalendar-clock\nmonitor\nlaptop\nsmartphone\ntablet\ntv\nserver\nhard-drive\ncpu\ndatabase\ncloud\ncloud-upload\nwifi\nglobe\nbrain\nsparkles\nbot\ncircuit-board\nmicrochip\nzap\nlightbulb\nmessage-square\nmessages-square\nscan-line\nworkflow\ngit-branch\ngit-commit\ngit-pull-request\ncode\ncode-2\nterminal\nlayers\nlayout-grid\nlayout-template\nsettings\nwrench\npuzzle\nbox\nboxes\nbar-chart-3\nline-chart\npie-chart\ntrending-up\nusers\nuser\nuser-check\nshield\nlock\nkey-round\nmail\nphone\nheadphones\ncamera\nimage\nvideo\nplay\nsearch\nmenu\nx\ncheck\nchevron-right\nchevron-left\narrow-right\narrow-left\nplus\nminus\ninfo\ncircle-alert\ntriangle-alert\ncircle-check\ncircle-x\nthumbs-up"
      }
    ]
  },
  {
    "name": "定制页面版块设计",
    "settings": [
      {
        "id": "cta_title",
        "type": "html",
        "label": "首页CTA行动号召（50 字以内）"
      },
      {
        "id": "brand_logos_on",
        "type": "checkbox",
        "label": "是否显示本版块",
        "info": "如果选中，则需要设置以下内容，否则略过",
        "default": true
      },
      {
        "id": "brand_logos",
        "type": "textarea",
        "label": "客户案例LOGO墙",
        "rows": 10,
        "info": "客户案例/合作伙伴 LOGO 墙，每行一个 URL 地址，建议添加 5 个以上",
        "default": ""
      },
      {
        "id": "aside_html",
        "type": "html",
        "label": "侧边栏广告代码",
        "info": "显示在文章页和频道页的侧边栏位置，支持 HTML 代码",
        "rows": 10,
        "placeholder": "<div style=\"padding: 10px; border: 1px solid #eee; text-align: center;\">Your Ad Here</div>"
      }
    ]
  },
  {
    "name": "页头页脚设置",
    "settings": [
      {
        "id": "head_html",
        "type": "html",
        "label": "t:settings_schema.nav.settings.head_html.label",
        "info": "t:settings_schema.nav.settings.head_html.info",
        "rows": 10,
        "placeholder": "t:settings_schema.nav.settings.head_html.placeholder"
      },
      {
        "id": "header_menu",
        "type": "textarea",
        "label": "页头导航菜单设置",
        "rows": 10,
        "info": "格式：menu_name[slug{sub_menu[slug|sub_menu[slug，每行一个分栏。",
        "default": "首页[/\n新闻资讯[/news\n服务项目[/services\n产品中心[/products\n视频资源[/videos\n关于我们[/about"
      },
      {
        "id": "footer_menu",
        "type": "textarea",
        "label": "页脚菜单设置",
        "rows": 10,
        "info": "格式：menu_name[slug]{sub_menu[slug|sub_menu[slug，每行一个分栏。",
        "default": "快捷导航[/about{公司介绍[/about|服务项目[/services|网站地图[/s/sitemap\nVideos[/videos{Catalog1[/products/pro1|Catalog2[/products/pro2\nNews[/news{Catalog1[/products/pro1|Catalog2[/products/pro2"
      },
      {
        "id": "company_info",
        "type": "html",
        "label": "页脚公司信息",
        "default": "Tailwind template designer, we build web templates, themes and other goodies, putting a lot of love in every pixel and design."
      },
      {
        "id": "copyright_info",
        "type": "html",
        "label": "页脚版权信息",
        "default": "Copyright © Baklib Inc. | All rights reserved."
      }
    ]
  }
]
